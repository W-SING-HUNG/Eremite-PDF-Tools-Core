{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdf-tools-core.supplier/protocol/v1/schema.json",
  "title": "PDF Tools Core Supplier Protocol v1",
  "description": "Machine-readable Supplier Protocol for the PDF Tools Core external core. This is NOT the Eremite Host Contract and holds no Host capability authority. Strict: additionalProperties false, all enums closed, operation-specific parameter shapes expressed via if/then, discriminated wire shapes via $defs + oneOf.",
  "type": "object",

  "$defs": {
    "uuid": {
      "type": "string",
      "description": "RFC 9562 UUID, versions 1-7, variant 10xx. Rejected: v8, nil UUID, wrong variant (NCS/MS/future), malformed. Version and variant are validated at runtime (byte-level); schema constrains shape.",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "operation": {
      "type": "string",
      "enum": ["pdf.merge", "pdf.split", "pdf.extract", "pdf.rotate", "pdf.reorder"]
    },
    "stage": {
      "type": "string",
      "enum": ["request", "input", "workspace", "parameter", "resource", "pdf_validation", "engine", "timeout", "output", "publish", "internal"]
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "request.malformed_json",
        "request.invalid_protocol_version",
        "request.invalid_uuid",
        "request.unknown_operation",
        "request.unknown_field",
        "request.invalid_parameter",
        "input.not_found",
        "input.zero_byte",
        "input.not_regular_file",
        "input.invalid_path",
        "input.escape",
        "input.snapshot_mismatch",
        "workspace.invalid_root",
        "workspace.escape",
        "parameter.invalid_page_selector",
        "parameter.invalid_page_index",
        "parameter.out_of_range",
        "parameter.empty_selector",
        "parameter.duplicate_output_name",
        "parameter.invalid_angle",
        "resource.max_input_files",
        "resource.max_input_bytes",
        "resource.max_total_input_bytes",
        "resource.max_output_files",
        "resource.max_output_bytes",
        "resource.max_total_output_bytes",
        "resource.max_pages",
        "resource.max_total_pages",
        "resource.max_workspace_bytes",
        "resource.timeout_exceeded",
        "pdf_validation.encrypted",
        "pdf_validation.requires_password",
        "pdf_validation.malformed",
        "pdf_validation.recoverable_anomaly",
        "pdf_validation.unsupported_feature",
        "engine.not_found",
        "engine.crash",
        "engine.nonzero_exit",
        "engine.invalid_output",
        "timeout.engine",
        "output.missing",
        "output.empty",
        "output.wrong_type",
        "output.page_count_mismatch",
        "output.exists",
        "publish.partial",
        "publish.failed",
        "internal.unexpected",
        "internal.not_implemented"
      ]
    },
    "warningCode": {
      "type": "string",
      "enum": ["w.duplicate_page_emitted", "w.document_features_dropped"]
    },
    "safeInteger": {
      "description": "JS Number safe integer (2^53 - 1). JSON Schema integer cannot express the JS safe-integer bound; this maximum plus a runtime Number.isSafeInteger check close the gap.",
      "maximum": 9007199254740991
    },
    "pageSelector": {
      "description": "0-based page selection. mode=pages carries an ordered (possibly duplicate) list; mode=ranges carries ordered inclusive ranges. Never a free string.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "pages"],
          "properties": {
            "mode": { "const": "pages" },
            "pages": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "ranges"],
          "properties": {
            "mode": { "const": "ranges" },
            "ranges": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["start", "end"],
                "properties": {
                  "start": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  "end": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                }
              }
            }
          }
        }
      ]
    },
    "splitParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "n"],
          "properties": {
            "type": { "const": "every" },
            "n": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        }
      }
    },
    "extractParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageSelector"],
      "properties": {
        "pageSelector": { "$ref": "#/$defs/pageSelector" }
      }
    },
    "rotateParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages", "angle", "mode"],
      "properties": {
        "pages": { "$ref": "#/$defs/pageSelector" },
        "angle": { "enum": [90, 180, 270] },
        "mode": { "enum": ["relative", "absolute"] }
      }
    },
    "reorderParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageOrder"],
      "properties": {
        "pageOrder": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootPath"],
      "properties": {
        "rootPath": { "type": "string", "minLength": 1 }
      }
    },
    "inputSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byteSize", "sha256", "displayName"],
      "properties": {
        "byteSize": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "displayName": { "type": "string" }
      }
    },
    "inputRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relativePath", "snapshot"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "relativePath": { "type": "string", "minLength": 1 },
        "snapshot": { "$ref": "#/$defs/inputSnapshot" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxInputFiles",
        "maxInputBytesPerFile",
        "maxTotalInputBytes",
        "maxOutputFiles",
        "maxOutputBytesPerFile",
        "maxTotalOutputBytes",
        "maxPagesPerInput",
        "maxTotalPages",
        "maxWorkspaceBytes",
        "timeoutMs"
      ],
      "properties": {
        "maxInputFiles": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxInputBytesPerFile": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxTotalInputBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxOutputFiles": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxOutputBytesPerFile": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxTotalOutputBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxPagesPerInput": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxTotalPages": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxWorkspaceBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "byteSize", "sha256", "pageCount", "relativePath"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string" },
        "byteSize": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "pageCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "relativePath": { "type": "string", "minLength": 1 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "stage": { "$ref": "#/$defs/stage" },
        "retryable": { "type": "boolean" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "$ref": "#/$defs/warningCode" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coreVersion", "protocolVersion", "operation"],
      "properties": {
        "coreVersion": { "type": "string" },
        "protocolVersion": { "const": 1 },
        "operation": { "$ref": "#/$defs/operation" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocolVersion", "invocationId", "operation", "workspace", "inputs"],
      "properties": {
        "kind": { "const": "pdf.tools.request" },
        "protocolVersion": { "const": 1 },
        "invocationId": { "$ref": "#/$defs/uuid" },
        "operation": { "$ref": "#/$defs/operation" },
        "workspace": { "$ref": "#/$defs/workspace" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/inputRef" }
        },
        "parameters": {},
        "limits": { "$ref": "#/$defs/limits" }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "pdf.merge" } } },
          "then": { "properties": { "parameters": false } }
        },
        {
          "if": { "properties": { "operation": { "const": "pdf.split" } } },
          "then": { "properties": { "parameters": { "$ref": "#/$defs/splitParameters" } }, "required": ["parameters"] }
        },
        {
          "if": { "properties": { "operation": { "const": "pdf.extract" } } },
          "then": { "properties": { "parameters": { "$ref": "#/$defs/extractParameters" } }, "required": ["parameters"] }
        },
        {
          "if": { "properties": { "operation": { "const": "pdf.rotate" } } },
          "then": { "properties": { "parameters": { "$ref": "#/$defs/rotateParameters" } }, "required": ["parameters"] }
        },
        {
          "if": { "properties": { "operation": { "const": "pdf.reorder" } } },
          "then": { "properties": { "parameters": { "$ref": "#/$defs/reorderParameters" } }, "required": ["parameters"] }
        }
      ]
    },
    "successResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocolVersion", "invocationId", "operation", "status", "outputs", "provenance", "warnings"],
      "properties": {
        "kind": { "const": "pdf.tools.response" },
        "protocolVersion": { "const": 1 },
        "invocationId": { "$ref": "#/$defs/uuid" },
        "operation": { "$ref": "#/$defs/operation" },
        "status": { "const": "succeeded" },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/output" }
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        }
      }
    },
    "failureResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocolVersion", "invocationId", "operation", "status", "error", "warnings"],
      "properties": {
        "kind": { "const": "pdf.tools.response" },
        "protocolVersion": { "const": 1 },
        "invocationId": { "$ref": "#/$defs/uuid" },
        "operation": { "$ref": "#/$defs/operation" },
        "status": { "const": "failed" },
        "error": { "$ref": "#/$defs/error" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        }
      }
    }
  },

  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/successResponse" },
    { "$ref": "#/$defs/failureResponse" }
  ]
}
